<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Recipes\Lombiq.Tests.UI.Tests.UI.WorkflowShortcutsTests.recipe.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Recipes\Lombiq.Tests.UI.Tests.UI.WorkflowShortcutsTests.recipe.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Libraries\Lombiq.HelpfulLibraries\Lombiq.HelpfulLibraries.Samples\Lombiq.HelpfulLibraries.Samples.csproj" />
    <ProjectReference Include="..\Lombiq.Tests.UI.TestingModule\Lombiq.Tests.UI.TestingModule.csproj" />
    <ProjectReference Include="..\Lombiq.Tests.UI\Lombiq.Tests.UI.csproj" />
  </ItemGroup>

  <!-- Suppresses vulnerabilities in 'SixLabors.ImageSharp' version 3.1.12, until the Orchard Core upgrade to v4 is
  released that drops ImageSharp. -->
